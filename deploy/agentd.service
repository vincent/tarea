# Install: copy the binary to /usr/local/bin/agentd, create /var/lib/agentd with
# jobs/ and .env (chmod 600), then: systemctl enable --now agentd
[Unit]
Description=agentd - scheduled LLM jobs
After=network-online.target
Wants=network-online.target

[Service]
User=agentd
Group=agentd
ExecStart=/usr/local/bin/agentd serve --data /var/lib/agentd --addr 127.0.0.1:8080
WorkingDirectory=/var/lib/agentd
Restart=on-failure
RestartSec=5
# Give in-flight runs time to finish on stop (matches the 2 minute shutdown grace).
TimeoutStopSec=130

NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
ReadWritePaths=/var/lib/agentd

[Install]
WantedBy=multi-user.target
